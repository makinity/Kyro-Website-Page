APP_NAME=KyroPad
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kyropad_website
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Mail (Brevo SMTP) ──────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_login_email
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_FROM_ADDRESS="noreply@kyropad.com"
MAIL_FROM_NAME="KyroPad"

VITE_APP_NAME="${APP_NAME}"

# ── Admin Credentials (seeded via AdminSeeder) ────────────────────────────────
ADMIN_NAME="KyroPad Administrator"
ADMIN_EMAIL=admin@kyropad.com
ADMIN_PASSWORD=password
